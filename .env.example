# Base de données locale (Docker) : lancer `pnpm db:up` puis `pnpm db:push`
# Ces identifiants correspondent à docker-compose.yaml
DATABASE_URL="postgresql://vinodomia:vinodomia@localhost:5432/vinodomia"

# Connexion directe utilisée par Prisma (migrations / db push)
DIRECT_URL="postgresql://vinodomia:vinodomia@localhost:5432/vinodomia"

# Secret de signature des tokens JWT (générer avec : openssl rand -hex 32)
NUXT_JWT_SECRET="change-me"
