// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          Int      @id @default(autoincrement())
  civility    String
  name        String
  phone1      String?
  phone2      String?
  email       String   @unique
  zipCode     String
  city        String
  subdivision String
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Products {
  id Int @id @default(autoincrement())
  ref String
  family String
  supplier String
  name String
  priceWithoutTax Float
  tax Float
  barCode String
  internalBarCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}